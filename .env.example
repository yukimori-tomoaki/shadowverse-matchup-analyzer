# ========================================================
# SHADOMAGI SYSTEM - 環境変数設定テンプレート
# ========================================================
# このファイルをコピーして「.env.local」を作成し、実際のAPIキーを入力してください。
# ※「.env.local」はGit管理から除外されているため、キーが外部に漏洩することはありません。

# OpenAI API Key (sk-...)
OPENAI_API_KEY=

# 使用するOpenAIモデル（デフォルト: gpt-4o-mini）
OPENAI_MODEL=gpt-4o-mini

# 出力最大トークン数（デフォルト: 1500）
OPENAI_MAX_TOKENS=1500

# タイムアウト時間（ミリ秒、デフォルト: 60000 = 60秒）
OPENAI_TIMEOUT_MS=60000
